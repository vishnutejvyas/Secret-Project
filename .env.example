# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: set this to the separately deployed API origin for a static frontend.
# GitHub Pages uses the VITE_API_BASE_URL repository variable at build time.
VITE_API_BASE_URL=""

# GOOGLE_SHEET_WEBAPP_URL: Optional deployed Google Apps Script Web App URL.
# Responses are forwarded to this URL to append rows to your private Google Sheet.
GOOGLE_SHEET_WEBAPP_URL="https://script.google.com/macros/s/AKfycb.../exec"
